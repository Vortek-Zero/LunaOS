# Ambientes virtuais Python (não precisam de backup, são baixados via requirements.txt)
.venv/
venv/

# Cache e arquivos compilados do Python (gerados automaticamente)
__pycache__/
*.pyc
*.pyo
*.pyd

# Pastas temporárias locais (não são arquivos úteis)
temp/

# Modelos de IA e arquivos pesados (>100MB) (bloqueados pelo limite do GitHub de 100MB)
*.onnx
*.bin
voice/models/
