# Luna — variáveis de ambiente (copie para .env e preencha)

# API
LUNA_API_HOST=127.0.0.1
LUNA_API_PORT=5050
# LUNA_API_KEY=          # gerada automaticamente em .api_key se omitida
LUNA_ADMIN_PASSWORD=      # senha para endpoints admin (obrigatória para /api/admin/*)

# LLM — pelo menos uma key recomendada
MISTRAL_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Puter.ai — TTS + LLM + Image (developer tier)
# PUTER_TOKEN=

# Provedores secundários
# NAGA_API_KEY=
# BESTAI_API_KEY=
# GITHUB_TOKEN=
# OPENROUTER_API_KEY=
# COMPLETIONS_API_KEY=
# FREETHEAI_API_KEY=

# Pesquisa / STT
TAVILY_API_KEY=

# Spotify
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://localhost:8888/callback

# Home Assistant (opcional)
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# WhatsApp bridge local opcional
# WHATSAPP_BRIDGE_URL=http://localhost:3001

# Worker distribuído (opcional)
LUNA_WORKER_URL=http://localhost:8000
LUNA_WORKER_API_KEY=

# TTS (opcional)
# LUNA_TTS_VOICE=pt-BR-ThalitaMultilingualNeural
# ELEVENLABS_API_KEY=
# AZURE_SPEECH_KEY=

# Tamanho do contexto do loop ReAct
# LUNA_MAX_STEPS=15